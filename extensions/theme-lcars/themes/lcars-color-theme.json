		"gitDecoration.untrackedResourceForeground": "#99CC99",
		"gitDecoration.deletedResourceForeground": "#CC6666",
		"gitDecoration.addedResourceForeground": "#99CC99",
		"gitDecoration.renamedResourceForeground": "#99CCFF",
		"gitDecoration.stageModifiedResourceForeground": "#FFCC66",
		"gitDecoration.stageDeletedResourceForeground": "#CC6666",
		"gitDecoration.ignoredResourceForeground": "#9999CC",
		"gitDecoration.conflictingResourceForeground": "#CC6699"
	},
	"tokenColors": [
		{ "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#9999CC", "fontStyle": "italic" } },
		{ "scope": ["string", "string.quoted"], "settings": { "foreground": "#99CCFF" } },
		{ "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#FFCC66" } },
		{ "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#FF9900" } },
		{ "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#CC99CC" } },
		{ "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"], "settings": { "foreground": "#CC6699" } },
		{ "scope": ["variable", "variable.other"], "settings": { "foreground": "#FFCC99" } },
		{ "scope": ["variable.parameter"], "settings": { "foreground": "#FFDDBB", "fontStyle": "italic" } },
		{ "scope": ["entity.name.tag", "meta.tag"], "settings": { "foreground": "#FF9900" } },
		{ "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#CC99CC" } },
		{ "scope": ["invalid"], "settings": { "foreground": "#CC6666" } }
	],
	"semanticHighlighting": true
}
