		"terminalCursor.foreground": "#FF9900",
		"terminal.ansiBlack": "#000000",
		"terminal.ansiRed": "#CC6666",
		"terminal.ansiGreen": "#99CC99",
		"terminal.ansiYellow": "#FFCC66",
