		"terminal.ansiBrightBlack": "#66503A",
		"terminal.ansiBrightRed": "#FF8888",
		"terminal.ansiBrightGreen": "#BBEEBB",
		"terminal.ansiBrightYellow": "#FFDD88",
		"terminal.ansiBrightBlue": "#BBBBEE",
		"terminal.ansiBrightMagenta": "#EE88BB",
		"terminal.ansiBrightCyan": "#BBDDFF",
